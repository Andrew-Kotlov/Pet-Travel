{
  "name": "@pet-travel/server",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/index.js",
    "start": "node --env-file-if-exists=../.env src/index.js",
    "build": "node ../scripts/check-server.mjs",
    "lint": "eslint src test",
    "test": "node --test test/unit.test.js",
    "test:integration": "node --env-file-if-exists=../.env.test --test --test-concurrency=1 test/integration.test.js test/migration.test.js",
    "db:migrate": "node --env-file-if-exists=../.env src/migrate.js",
    "db:seed": "node --env-file-if-exists=../.env src/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "sequelize": "^6.37.8",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  }
}
